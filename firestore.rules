rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function isAdmin() {
      return hasRole('admin');
    }
    
    function isPengurus() {
      return hasRole('pengurus');
    }
    
    function isAnggota() {
      return hasRole('anggota');
    }
    
    function isWarga() {
      return hasRole('warga');
    }
    
    function isKetuaRT() {
      return hasRole('ketua_rt');
    }
    
    function isAdminOrPengurus() {
      return isAdmin() || isPengurus();
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Admin dapat CRUD semua user
      // User dapat read & update profil sendiri
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }
    
    // Kegiatan collection
    match /kegiatan/{kegiatanId} {
      // Semua authenticated user dapat read
      // Admin & Pengurus dapat CRUD
      // Anggota dapat daftar (update pesertaIds)
      allow read: if isAuthenticated();
      allow create: if isAdminOrPengurus();
      allow update: if isAdminOrPengurus() || 
                      (isAnggota() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pesertaIds', 'absensiIds']));
      allow delete: if isAdmin();
    }
    
    // Kas collection
    match /kas/{kasId} {
      // Admin, Pengurus, Ketua RT, Anggota dapat read
      // Admin & Pengurus dapat create & update
      // Admin dapat delete
      allow read: if isAuthenticated() && !isWarga();
      allow create: if isAdminOrPengurus();
      allow update: if isAdminOrPengurus();
      allow delete: if isAdmin();
    }
    
    // Berita collection
    match /berita/{beritaId} {
      // Public berita dapat dibaca semua orang (even unauthenticated)
      // Private berita hanya untuk authenticated
      // Admin & Pengurus dapat CRUD
      allow read: if resource.data.isPublic == true || isAuthenticated();
      allow create: if isAdminOrPengurus();
      allow update: if isAdminOrPengurus();
      allow delete: if isAdmin();
    }
    
    // Aspirasi collection
    match /aspirasi/{aspirasiId} {
      // User dapat read aspirasi mereka sendiri
      // Admin, Pengurus, Ketua RT dapat read semua
      // Semua authenticated user dapat create
      // Admin & Pengurus dapat update (untuk balas)
      allow read: if isOwner(resource.data.createdBy) || isAdminOrPengurus() || isKetuaRT();
      allow create: if isAuthenticated();
      allow update: if isAdminOrPengurus();
      allow delete: if isAdmin();
    }
    
    // Laporan collection
    match /laporan/{laporanId} {
      // Admin, Pengurus, Ketua RT dapat read
      // Admin & Pengurus dapat CRUD
      allow read: if isAdminOrPengurus() || isKetuaRT();
      allow create: if isAdminOrPengurus();
      allow update: if isAdminOrPengurus();
      allow delete: if isAdmin();
    }
    
    // Log Aktivitas collection
    match /log_aktivitas/{logId} {
      // Hanya Admin yang dapat read & create
      // Tidak ada yang bisa update atau delete
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }
    
    // Settings collection (untuk konfigurasi app)
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
